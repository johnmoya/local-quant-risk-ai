# Copy to .env and adjust as needed. See src/quant_risk_ai/config.py for
# defaults and src/quant_risk_ai/llm/ollama_client.py for how the Ollama
# settings are used.
#
# Native/local dev: all four QUANT_RISK_AI_OLLAMA_* values below apply as
# written (Ollama running on the host).
#
# docker-compose.yml: QUANT_RISK_AI_OLLAMA_BASE_URL is fixed there to
# http://ollama:11434 (the compose service's DNS name) and does not read
# this file for that one variable — localhost has no meaning inside the
# api container. QUANT_RISK_AI_OLLAMA_MODEL/_TIMEOUT_SECONDS and the
# QUANT_RISK_AI_DEFAULT_* values below ARE read from a .env file next to
# docker-compose.yml (Compose loads it automatically for ${...}
# substitution) if you want to override their defaults for the stack.

# --- Ollama client (src/quant_risk_ai/llm/ollama_client.py) ---
QUANT_RISK_AI_OLLAMA_BASE_URL=http://localhost:11434
QUANT_RISK_AI_OLLAMA_MODEL=qwen3:8b
QUANT_RISK_AI_OLLAMA_TIMEOUT_SECONDS=60

# --- Risk-endpoint request defaults (src/quant_risk_ai/config.py) ---
QUANT_RISK_AI_DEFAULT_ALPHA=0.99
QUANT_RISK_AI_DEFAULT_HORIZON_DAYS=1
QUANT_RISK_AI_DEFAULT_N_SIMULATIONS=100000
QUANT_RISK_AI_DEFAULT_TEST_CONFIDENCE=0.95

# --- Structured logging (src/quant_risk_ai/core/logging.py) ---
# One of DEBUG/INFO/WARNING/ERROR/CRITICAL.
QUANT_RISK_AI_LOG_LEVEL=INFO
